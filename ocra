import hashlib
import json
from typing import Dict, Any

class JohnsonMerkleSealer:
    def __init__(self, payload_dict: Dict[str, Any]):
        self.payload = payload_dict
        self.serialized_payload = json.dumps(
            self.payload, sort_keys=True, ensure_ascii=False
        )
        self.hash_signature = self._generate_sha256()

    def _generate_sha256(self) -> str:
        return hashlib.sha256(
            self.serialized_payload.encode('utf-8')
        ).hexdigest()

    def export_merkle_node(self) -> Dict[str, Any]:
        return {
            "node_type": "CPIA_CONTEXT_LEAF",
            "sha256_root_fingerprint": self.hash_signature,
            "status": "SEALED_FOR_OTS",
            "governance_compliance": self.payload.get("etica", {}),
            "timestamp": self.payload.get("timestamp")
        }

